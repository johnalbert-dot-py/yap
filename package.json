{
  "name": "yap",
  "version": "1.0.0",
  "description": "Local HTTP-first YAML runtime for fetching HTML or JSON, scraping named fields, paginating, and returning JSON.",
  "license": "MIT",
  "bin": {
    "yap": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "prepack": "rm -rf dist && node ./node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "yap": "tsx src/cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cheerio": "^1.2.0",
    "js-yaml": "^5.4.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
